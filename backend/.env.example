# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/lintwise

# ─── JWT ──────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-chars
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Claude AI ────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-your-anthropic-api-key-here

# ─── Mail ─────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=LintWise <noreply@lintwise.com>
